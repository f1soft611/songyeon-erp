<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="loginDAO">

    <!-- 로그인 처리를 위한 resultMap -->
    <resultMap id="login" type="egovframework.com.cmm.LoginVO">
        <result property="factoryCode" column="factoryCode"/>
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="ihidNum" column="ihidNum"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="userSe" column="userSe"/>
        <result property="orgnztId" column="orgnztId"/>
        <result property="uniqId" column="uniqId"/>
        <!-- 누락된 필드 추가 -->
        <result property="groupId" column="groupId"/>
        <result property="groupNm" column="groupNm"/>
    </resultMap>

    <!-- 아이디 찾기를 위한 resultMap
    <resultMap id="id" class="egovframework.com.cmm.LoginVO">
        <result property="id" column="id" columnIndex="1"/>
    </resultMap>
    -->
    <!-- 비밀번호 찾기를 위한 resultMap
    <resultMap id="password" class="egovframework.com.cmm.LoginVO">
        <result property="password" column="password" columnIndex="1"/>
    </resultMap>
    -->

    <!-- 일반 로그인 -->
    <select id="actionLogin" resultMap="login">
        SELECT
            '000001' AS factoryCode,
            a.ESNTL_ID AS id,
            a.USER_NM AS name,
            a.PASSWORD AS password,
            a.IHIDNUM AS ihidNum,
            a.EMAIL_ADRES AS email,
            'USR' AS userSe,
            a.ORGNZT_ID AS orgnztId,
            a.EMPLYR_ID AS uniqId,
            b.GROUP_ID AS groupId,
            b.GROUP_CODE AS groupCode,
            b.GROUP_NM AS groupNm
        FROM TB_UserInfo a
        LEFT JOIN TB_DepartmentInfo b
          ON a.GROUP_ID = b.GROUP_ID
        WHERE a.EMPLYR_ID = #{id}
          AND a.PASSWORD = #{password}
    </select>

    <!-- 인증서 로그인
    <select id="actionCrtfctLogin" resultMap="login">
        <![CDATA[
        SELECT emplyr_id AS id
             , USER_NM AS name
             , password AS password
             , ihidnum AS ihidNum
             , email_adres AS email
             , 'USR' AS userSe
             , orgnzt_id AS orgnztId
             , ESNTL_ID AS uniqId
          FROM TB_UserInfo
         WHERE sub_dn = #{dn}
        ]]>
    </select>
    -->

    <!-- 아이디 찾기
    <select id="searchId" resultMap="id">
        <isEqual property="userSe" compareValue="GNR">
            <![CDATA[
            SELECT mber_id AS id
              FROM TB_GeneralMember
             WHERE mber_nm = #{name}
               AND mber_email_adres = #{email}
               AND mber_sttus = 'P'
            ]]>
        </isEqual>
        <isEqual property="userSe" compareValue="ENT">
            <![CDATA[
            SELECT entrprsmber_id AS id
              FROM TB_EnterpriseMember
             WHERE cmpny_nm = #{name}
               AND applcnt_email_adres = #{email}
               AND entrprs_mber_sttus = 'P'
            ]]>
        </isEqual>
        <isEqual property="userSe" compareValue="USR">
            <![CDATA[
            SELECT emplyr_id AS id
              FROM TB_UserInfo
             WHERE USER_NM = #{name}
               AND email_adres = #{email}
               AND emplyr_sttus_code = 'P'
            ]]>
        </isEqual>
    </select>
    -->

    <!-- 비밀번호 찾기
    <select id="searchPassword" resultMap="password">
        <isEqual property="userSe" compareValue="GNR">
            <![CDATA[
            SELECT password AS password
              FROM TB_GeneralMember
             WHERE mber_id = #{id}
               AND mber_nm = #{name}
               AND mber_email_adres = #{email}
               AND password_hint = #{passwordHint}
               AND password_cnsr = #{passwordCnsr}
               AND mber_sttus = 'P'
            ]]>
        </isEqual>
        <isEqual property="userSe" compareValue="ENT">
            <![CDATA[
            SELECT entrprs_mber_password AS password
              FROM TB_EnterpriseMember
             WHERE entrprsmber_id = #{id}
               AND cmpny_nm = #{name}
               AND applcnt_email_adres = #{email}
               AND entrprs_mber_password_hint = #{passwordHint}
               AND entrprs_mber_password_cnsr = #{passwordCnsr}
               AND entrprs_mber_sttus = 'P'
            ]]>
        </isEqual>
        <isEqual property="userSe" compareValue="USR">
            <![CDATA[
            SELECT password AS password
              FROM TB_UserInfo
             WHERE emplyr_id = #{id}
               AND USER_NM = #{name}
               AND email_adres = #{email}
               AND password_hint = #{passwordHint}
               AND password_cnsr = #{passwordCnsr}
               AND emplyr_sttus_code = 'P'
            ]]>
        </isEqual>
    </select>
    -->

    <!-- 변경된 비밀번호 반영
    <update id="updatePassword">
        <isEqual property="userSe" compareValue="GNR">
            <![CDATA[
            UPDATE TB_GeneralMember
               SET password = #{password}
             WHERE mber_id = #{id}
            ]]>
        </isEqual>
        <isEqual property="userSe" compareValue="ENT">
            <![CDATA[
            UPDATE TB_EnterpriseMember
               SET entrprs_mber_password = #{password}
             WHERE entrprsmber_id = #{id}
            ]]>
        </isEqual>
        <isEqual property="userSe" compareValue="USR">
            <![CDATA[
            UPDATE TB_UserInfo
               SET password = #{password}
             WHERE emplyr_id = #{id}
            ]]>
        </isEqual>
    </update>
    -->
</mapper>
