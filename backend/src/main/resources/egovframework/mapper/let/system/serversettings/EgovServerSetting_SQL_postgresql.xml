<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 기초정보 - 서버관리 (송연 external_api_settings, 기존 /api/server-settings 와 같은 값). 키는 'enc:' 로 잠긴 채 들어 있다. -->
<mapper namespace="ServerSettingDAO">

    <resultMap id="serverSetting" type="egovframework.let.system.serversettings.domain.model.ServerSettingVO">
        <result property="serviceKey" column="service_key"/>
        <result property="serviceName" column="service_name"/>
        <result property="apiKey" column="api_key"/>
        <result property="apiSecret" column="api_secret"/>
        <result property="baseUrl" column="base_url"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectServerSetting" parameterType="string" resultMap="serverSetting">
        SELECT
            service_key,
            service_name,
            api_key,
            api_secret,
            base_url,
            updated_at
        FROM external_api_settings
        WHERE service_key = #{serviceKey}
    </select>
</mapper>
